#!./shsl
;; -*- mode:clojure -*-
;; vi: set ft=clojure:

;; so uh... I don't have quasi quoting :|
;; yet
(def defmacro
  (macro [name args & body]
         (cons 'def
               (cons name
                     (list
                      (cons 'macro
                            (cons args
                                  (vec->list body))))))))

(defmacro defn [name args & body]
  (cons 'def
        (cons name
              (list
               (cons 'fn
                     (cons args
                           (vec->list body)))))))

;; TODO: the current implementation of gensym is kinda ass
;; because we don't intern symbols so our uniqueness check is only
;; "is this symbol currenly bound to something"
;; this means that two calls to gensym within the same macro where we don't bind
;; any symbol between the two gensym invocations will most likely return the same
;; symbol
;; this isn't really a problem right here right now
;; but it's likely to become a problem right here right later

;; we don't got quasiquoting at the moment so yeah, this is kinda ass
(defn or-gen [args]
  (if (= 0 (vec-len args))
    nil
    (if (= 1 (vec-len args))
      (vec-get args 0)
      (let [first (vec-get args 0)
            rest (vec-slice args 1)
            first-sym (gensym "check")]
        (list
         'let (vec first-sym first)
         (list 'if first-sym first-sym
               (or-gen rest)))))))

(defmacro or [& args]
  (or-gen args))

(defn and-gen [args]
  (if (= 0 (vec-len args))
    nil
    (if (= 1 (vec-len args))
      (vec-get args 0)
      (let [first (vec-get args 0)
            rest (vec-slice args 1)
            first-sym (gensym "check")]
        (list
         'let (vec first-sym first)
         (list 'if (list 'not first-sym) first-sym
               (and-gen rest)))))))

(defmacro and [& args]
  (and-gen args))

(defn str-at [s i]
  (substr s i (+ i 1)))
