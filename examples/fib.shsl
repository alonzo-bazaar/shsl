(def fib-naive
  (fn [a]
    (if (< a 0) (err "what the fuck bro")
        (if (<= a 1)
          1
          (+ (fib-naive (- a 1)) (fib-naive (- a 2)))))))

(let [i 0]
  (while (< i 10)
    (println "(fib" i ") =" (fib-naive i))
    (set i (+ i 1))))

(def fib-fast-as-fuck
  (fn [n]
    (let [a 1
          b 1
          i 0]
      (while (< i n)
        (set i (+ i 1))
        (def c (+ a b))
        (set a b)
        (set b c))
      a)))

(let [i 0]
  (while (< i 30)
    (println "(fib" i ") =" (fib-fast-as-fuck i))
    (set i (+ i 1))))
