#!./shsl
;; -*- mode:clojure -*-
;; vi: set ft=clojure:

;; basic utils and shit
(defn arg? [arg]
  (find argv arg))

(defn die [msg]
  (println (str "[FATAL ERROR] " msg))
  (exit 1))

(defn peace-out []
  (println (str "[PEACE OUT] cya!"))
  (exit 0))

(def log-step? (not (arg? "--no-log-step")))
(def log-cmd? (arg? "--log-cmd"))

(defn exec-or-die [name cmd]
  (when log-step? (println (str "now at step: " name "...")))
  (when log-cmd? (println (str "running command:\n" cmd)))
  (set status (exec-vec cmd))
  (when log-step? (println (str "finished step: " name "\n")))
  (or status (die "step exited with failure, exiting build script")))

;; global data used by the various build steps
(def cc
  (cond ((arg? "--gcc") "gcc")
        ((arg? "--g++") "g++")
        ((arg? "--clang") "clang")
        ((arg? "--clang++") "clang++")
        ((arg? "--mingw") "x86_64-w64-mingw32-gcc")
        ((arg? "--mingw++") "x86_64-w64-mingw32-g++")
        (t "gcc")))

(def common-cflags
  (let [warnings
        ["-Wall" "-Wextra" "-Wpedantic" "-Wswitch" "-Wno-parentheses" "-Werror"]
        debug-flags
        (vec-cat ["-O0" "-g3" "-ggdb"]
                 (if (= cc "gcc")
                   ["--coverage" "-fprofile-arcs" "-ftest-coverage"] []))
        release-flags
        ["-02" "-g"]]
    (vec-cat
     warnings
     (if (arg? "--release") release-flags debug-flags))))

;; defn's for the various build steps
(defn compile-exe []
  (exec-or-die "deleting artefacts of previous compilation"
               ["rm" "-f"
                ;; executables
                "shsl" "test"
                ;; gcov compilation shit
                "shsl.gcda" "shsl.gcno"])

  (exec-or-die "compiling shsl executable"
               (vec-cat
                [cc]
                common-cflags
                ["-DSHSL_LOG_ERROR_EXPR"]
                ["-o" "shsl" "shsl.c"])))

(defn run-self-tests []
  (exec-or-die "running self tests"
               ["./shsl" "-f" "./selftest.shsl"]))

(defn run-shell-tests []
  (exec-or-die "running shell tests"
               ["./test.sh"]))

(defn compile-library-tests []
  (exec-or-die "compiling library tests"
               (vec-cat
                [cc]
                common-cflags
                ["-DSHSL_LOG_ERROR" "-DSHSL_LOG_ERROR_EXPR"]
                (if (arg? "--test-logging") ["-DSHSL_LOG_TESTS"] [])
                ["-o" "test" "test.c"])))

(defn run-library-tests []
  (exec-or-die "running library tests"
               ["./test"]))

(defn run-valgrind-tests []
  (exec-or-die "running self tests under valgrind"
               ["valgrind"
                "--tool=memcheck" "--leak-check=full" "-s"
                "./shsl" "./selftest.shsl"]))

(defn run-gcov-tests []
  ;; if previous gcov files already exist gcov will just add the current run's
  ;; results onto the pre-existing file results
  ;; this will be useful later but as of now I don't really want this behaviour
  (exec-or-die "deleting results of last gcov run"
               ["rm" "-f"
                "shsl.c.gcov" "shsl.h.gcov"])
  (exec-or-die "running self tests to collect gcov-data"
               ["./shsl" "-f" "./selftest.shsl"])
  (exec-or-die "printing coverage information"
               ["gcov" "shsl.c"]))

(defn main []
  (cond ((arg? "--compile-only")
         (compile-exe))

        ((arg? "--valgrind-only")
         (run-valgrind-tests))
        ((arg? "--valgrind-run")
         (compile-exe)
         (run-valgrind-tests))

        ((arg? "--gcov-only")
         (run-gcov-tests))
        ;; TBD: to be debugged
        ;; ((arg? "--gcov-run")
        ;;  (compile-exe)
        ;;  (run-gcov-tests))

        (t
         (compile-exe)
         (run-self-tests)
         (run-shell-tests)
         (compile-library-tests)
         (run-library-tests))))

(main)
(println "if none of the above aborted we're all good")
