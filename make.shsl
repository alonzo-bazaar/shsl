#!./shsl
;; -*- mode:clojurescript -*-
;; vi: set ft=clojure:
(def exec-or-die
  (fn [name cmd]
    (println (str "now at step: " name "..."))
    (set status (exec-vec cmd))
    (println (str "finished step: " name "\n"))
    (if (not status)
      (do
        (println "step exited with failure, exiting build script")
        (exit 1)))))

(def cc "gcc")
(def common-cflags ["-Wall" "-Wextra" "-Wpedantic" "-Wswitch" "-Wno-parentheses"
                    "-Werror"
                    "-O0" "-g3" "-ggdb"])

(exec-or-die "compiling shsl executable"
             (vec-cat
              [cc]
              common-cflags
              ["-DSHSL_LOG_ERROR" "-DSHSL_LOG_ERROR_EXPR"]
              ["-o" "shsl" "shsl.c"]))

(exec-or-die "running self tests"
             ["./selftest.shsl"])

(exec-or-die "running shell tests"
             ["./test.sh"])

(exec-or-die "compiling library tests"
             (vec-cat
              [cc]
              common-cflags
              ["-DSHSL_LOG_ERROR" "-DSHSL_LOG_ERROR_EXPR"]
                                        ; ["-DSHSL_LOG_TESTS"]
              ["-o" "tests" "tests.c"]))

(exec-or-die "running library tests"
             ["./tests"])

(println "if nothing above aborted all tests pass!")
