#!./shsl
;; -*- mode:clojure -*-
;; vi: set ft=clojure:

;; global functions
(defn arg? [arg]
  (find argv arg))

(defn die [msg]
  (println (str "[FATAL ERROR] " msg))
  (exit 1))

(defn peace-out []
  (println (str "[PEACE OUT] cya!"))
  (exit 0))

(def log-step? (not (arg? "--no-log-step")))
(def log-cmd? (not (arg? "--no-log-cmd")))

(defn exec-or-die [name cmd]
  (when log-step? (println (str "now at step: " name "...")))
  (when log-cmd? (println (str "running command:\n" cmd)))
  (set status (exec-vec cmd))
  (when log-step? (println (str "finished step: " name "\n")))
  (or status (die "step exited with failure, exiting build script")))

(defn exec-valgrind []
  (exec-or-die "running self tests under valgrind"
               ["valgrind"
                "--tool=memcheck" "--leak-check=full" "-s"
                "./shsl" "./selftest.shsl"]))

;; global data
(def cc
  (cond ((arg? "--gcc") "gcc")
        ((arg? "--g++") "g++")
        ((arg? "--clang") "clang")
        ((arg? "--clang++") "clang++")
        ((arg? "--mingw") "x86_64-w64-mingw32-gcc")
        ((arg? "--mingw++") "x86_64-w64-mingw32-g++")
        (t "gcc")))

(def common-cflags
  (vec-cat
   ["-Wall" "-Wextra" "-Wpedantic" "-Wswitch" "-Wno-parentheses" "-Werror"]
   (cond ((arg? "--release") ["-02" "-g"])
         ((arg? "--debug") ["-O0" "-g3" "-ggdb"])
         (t ["-O0" "-g3" "-ggdb"]))))

;; and here's the bit where we do shit
(if (arg? "--valgrind-only")
  (do (exec-valgrind) (peace-out)))

(exec-or-die "compiling shsl executable"
             (vec-cat
              [cc]
              common-cflags
              ["-DSHSL_LOG_ERROR_EXPR"]
              ["-o" "shsl" "shsl.c"]))

(if (arg? "--compile-only")
  (peace-out))

(if (arg? "--valgrind")
  (do (exec-valgrind)
      (if (arg? "--stop-at-valgrind") (peace-out))))

(exec-or-die "running self tests"
             ["./selftest.shsl"])

(if (arg? "--stop-at-self-test")
  (peace-out))

(exec-or-die "running shell tests"
             ["./test.sh"])

(if (or (arg? "--stop-at-shell-test")
        (arg? "--no-library-test"))
  (peace-out))

(exec-or-die "compiling library tests"
             (vec-cat
              [cc]
              common-cflags
              ["-DSHSL_LOG_ERROR" "-DSHSL_LOG_ERROR_EXPR"]
              (if (arg? "--test-logging") ["-DSHSL_LOG_TESTS"] [])
              ["-o" "tests" "tests.c"]))

(exec-or-die "running library tests"
             ["./tests"])

(println "if none of the above aborted we're all good")
