(def usage
  (fn []
    (print "usage:" progname "[subcommand]" "[flags]")
    (print "accepted subcommands are:")
    (print "  [no subcommand]: defaults to all")
    (print "  build: build targets")
    (print "  test: run tests")
    (print "  all: build targets then run tests")
    (print "")

    (print "flags accepted by all subcommands are:")
    (print "  -h    :"
           "print this help message and exit")
    (print "  --help:"
           "same thing but takes more characters to type")
    (print "")

    (print "accepted flags for build subcommand are:")
    (print "  --cc=[c compiler]")
    (print "    specifies which c compiler to use for build")
    (print "    supported compilers so far are")
    (print "    * gcc")
    (print "    * g++")
    (print "    * clang")
    (print "    * clang++")
    (print "    * mingw-gcc (gets turned into x86_64-w64-mingw-gcc)")
    (print "    * mingw-g++ (gets turned into x86_64-w64-mingw-g++)")
    (print "  -l [comma separated list of definitions]:")
    (print "  or")
    (print "  --log=[comma separated list of definitions]:")
    (print "  where list can contain any of the following") 
    (print "    * err")
    (print "    * errexpr")
    (print "    * mem")
    (print "    * gc")
    (print "    * delref")
    (print "  preprocessor directives will then be added to log")
    (print "  when any of the requested events happen within shsl")
    (print "")

    (print "accepted flags for test subcommand are:")
    (print "  -l [comma separated list of definitions]:")
    (print "  or")
    (print "  --log=[comma separated list of definitions]:")
    (print "  where list can contain any of the following:") 
    (print "    * test")
    (print "  preprocessor directives will then be added to log")
    (print "  when any of the requested events happen within shsl")))

;; build up compilation commands
;; get cc
(def compiler-shorthands
  {
   "mingw-gcc" "x86_64-w64-mingw-gcc"
   "mingw-g++" "x86_64-w64-mingw-g++"
   })
(def compiler-default "gcc")
(def cc (let [cc-param (param "--cc")]
          (if (null? cc-param) ;; param not found
            compiler-default
              (if (contains? compiler-shorthands cc-param)
                (get compiler-shorthands cc-param)
                cc-param))))

;; build up compiler flags
(def common-cflags ["-Wall" "-Wextra" "-Wpedantic"
                    "-Wswitch" "-Wno-parentheses"
                    "-Werror"
                    "-O0" "-g3" "-ggdb"])

(def logging-shorthands
  {
   ;; preprocessor definitions flags for library and interpreter
   "err" "-DSHSL_LOG_ERROR"
   "errexpr" "-DSHSL_LOG_ERROR_EXPR"
   "mem" "-DSHSL_LOG_ERROR_EXPR"
   "gc" "-DSHSL_LOG_GC"
   "delref" "-DSHSL_LOG_DEL_REF"

   ;; preprocessor definitions flags for library C tests
   "test" "-DSHSL_LOG_TESTS"
   })

