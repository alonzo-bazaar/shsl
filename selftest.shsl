#!./shsl
;; -*- mode:clojure -*-
;; vi: set ft=clojure:

;; this is a port of most of the old test.sh file to shsl
;; it's just more convenient for a lot of tasks than having to invoke
;; shsl half a dozen times

(def log-always nil)
(defn logln [arg]
  (println (str "[" progname "] " arg)))

;; this should have been a macro :(
(def asseq
  (fn [expected actual testname]
    (if log-always (logln (str "testing: [" testname "]")))
    (if (!= expected actual)
      (do
        (err (str "\nexpected value: - " expected
                  "\nwas supposed to be equal to"
                  "\nactual value:   - " actual ""
                  "\nbut it's not")
             testname)
        (println "")))))

;; basic operations
(asseq  4 (+ 2 2) "addition")
(asseq  4 (* 2 2) "multiplication")
(asseq  0 (- 2 2) "subtraction")
(asseq -1 (- 2 3) "subtraction order")

;; basic serializations
(asseq "a" (str 'a) "serializing symbol literals")
(asseq "b" (str 'b) "serializing symbol literals")
(asseq "t" (str t)  "t should be self evaluating")

(asseq "(a b c d)" (str '(a b c d)) "serialize quoted list")
(asseq "[a b c d]" (str '[a b c d]) "serialize quoted vector literals")
(asseq "{a b c d}" (str '{a b c d}) "serialize quoted map literals")

;; unquoted collections
(asseq [1 2 3 4] [1 2 3 4]         "unquoted vectors")
(asseq {1 2 3 4} {1 2 3 4}         "unquoted maps")
(asseq [1 2 3 10] [1 2 3 (+ 5 5)]  "unquoted vectors with computed elements")
(asseq {1 2 10 4} {1 2 (+ 6 4) 4}  "unquoted maps with computed keys")
(asseq {1 2 3 10} {1 2 3 (+ 6 4)}  "unquoted maps with computed values")

;; make sure empty collections work
(asseq '() '() "empty list")

(asseq [] []    "empty vector")
(asseq [] '[]   "empty quoted vector")
(asseq '[] []   "empty quoted vector")
(asseq '[] '[]  "empty quoted vector")

(asseq {} {}    "empty map")
(asseq {} '{}   "empty quoted map")
(asseq '{} '{}  "empty quoted map")
(asseq '{} {}   "empty quoted map")

;; if then else
(asseq 'b (if nil 'a 'b)
       "if nil then else")
(asseq nil (if nil 'a)
       "if nil then")
(asseq 'a (if t 'a 'b)
       "if t then else")
(asseq 'a (if t 'a)
       "if t then")
(asseq 'a (if 'a 'a)
       "if <something> then")
(asseq 'a (if 'a 'a 'b)
       "if <something> then else")

(defmacro muted [& body]
  (cons 'with-log-level (cons log-level-none (vec->list body))))
(asseq nil (if (muted (err "you should not see this error" 'dwai)) 'a)
       "errors should be falsey")

(asseq nil (if (err "you should be seeing see this error" "it's all good :3") 'a)
       "errors should be falsey")
(asseq "goodbye" (if (!= "a" (str 'a)) "hello" "goodbye")
       "if then else")
(asseq nil (if (!= "a" (str 'a)) "hello")
       "if then else")

;; let&Co. blocks
(asseq 10 (do (def a 10) (let [a [1 2 3]] a) a)
       "let blocks should be local")
(asseq [1 2 3] (do (def a [1 2 3]) (let [a 10] a) a)
       "let blocks should be local")
(asseq 10 (do (def a [1 2 3]) (let [a 10] a))
       "do blocks should return the last thing therein")
(asseq [1 2 3] (do (def a 10) (let [a [1 2 3]] a))
       "do blocks should return the last thing therein")

;; basic predicates
(asseq true (nil? nil) "basic predicates")
(asseq true (nil? '()) "basic predicates")
(asseq false (nil? t) "basic predicates")

(asseq true (sym? t)      "basic predicates")
(asseq true (sym? 'hello) "basic predicates")
(asseq false (sym? 'nil) "basic predicates")
(asseq false (sym? 10)   "basic predicates")

;; advanced lambda fuckery
(asseq 10000
       (((fn [a] (fn [b] (a (a b)))) (fn [a] (* a a))) 10)
       "advanced lambda fuckery")

;; macros&Co.
(asseq 10 ((macro [name idfk] (list name idfk)) + 10) "basic macro stuff")

;; macrolet-ery
;; this test is invalid given the current spec for how we're doing macros
;; gotta work on it a bit
;; (asseq 10
;;  (let [ctadd (macro [a b] (+ a b))
;;        ctsub (macro [a b] (- a b))
;;        ctfst (macro [a b] a)
;;        ctsnd (macro [a b] b)]
;;    (ctadd (ctfst 5 10) (ctfst 5 10)))
;;  "local macros and nested macroexpand fuckery")

(logln "end of tests! :D")
